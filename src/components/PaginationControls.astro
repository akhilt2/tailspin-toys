---
interface Props {
    page: number;
    totalPages: number;
}

const { page, totalPages } = Astro.props;
const pageNumbers = Array.from({ length: totalPages }, (_, index) => index + 1);

function pageHref(pageNumber: number): string {
    return pageNumber === 1 ? '/' : `/page/${pageNumber}`;
}
---

{
    totalPages > 1 && (
        <nav aria-label="Game list pagination" class="mt-8" data-testid="pagination-nav">
            <ul class="flex flex-wrap items-center gap-2" data-testid="pagination-list">
                <li>
                    {page > 1 ? (
                        <a
                            href={pageHref(page - 1)}
                            class="inline-flex items-center rounded-lg border border-slate-600 bg-slate-800 px-3 py-2 text-sm font-medium text-slate-100 transition-colors hover:bg-slate-700 focus:outline-none focus:ring-2 focus:ring-blue-500"
                            data-testid="pagination-previous"
                        >
                            Previous
                        </a>
                    ) : (
                        <span
                            class="inline-flex items-center rounded-lg border border-slate-700 bg-slate-900 px-3 py-2 text-sm font-medium text-slate-500"
                            aria-disabled="true"
                            data-testid="pagination-previous-disabled"
                        >
                            Previous
                        </span>
                    )}
                </li>

                {pageNumbers.map((pageNumber) => (
                    <li>
                        {pageNumber === page ? (
                            <span
                                class="inline-flex items-center rounded-lg border border-blue-500 bg-blue-600/20 px-3 py-2 text-sm font-semibold text-slate-100"
                                aria-current="page"
                                data-testid={`pagination-page-${pageNumber}-current`}
                            >
                                {pageNumber}
                            </span>
                        ) : (
                            <a
                                href={pageHref(pageNumber)}
                                class="inline-flex items-center rounded-lg border border-slate-600 bg-slate-800 px-3 py-2 text-sm font-medium text-slate-100 transition-colors hover:bg-slate-700 focus:outline-none focus:ring-2 focus:ring-blue-500"
                                data-testid={`pagination-page-${pageNumber}`}
                            >
                                {pageNumber}
                            </a>
                        )}
                    </li>
                ))}

                <li>
                    {page < totalPages ? (
                        <a
                            href={pageHref(page + 1)}
                            class="inline-flex items-center rounded-lg border border-slate-600 bg-slate-800 px-3 py-2 text-sm font-medium text-slate-100 transition-colors hover:bg-slate-700 focus:outline-none focus:ring-2 focus:ring-blue-500"
                            data-testid="pagination-next"
                        >
                            Next
                        </a>
                    ) : (
                        <span
                            class="inline-flex items-center rounded-lg border border-slate-700 bg-slate-900 px-3 py-2 text-sm font-medium text-slate-500"
                            aria-disabled="true"
                            data-testid="pagination-next-disabled"
                        >
                            Next
                        </span>
                    )}
                </li>
            </ul>
        </nav>
    )
}
